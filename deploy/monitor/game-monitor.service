[Unit]
Description=Duel game server monitor on local console
After=network-online.target postgresql.service game-server.service
Wants=network-online.target

[Service]
Type=simple
User=dev-admin
SupplementaryGroups=adm tty
WorkingDirectory=/home/dev-admin/game
Environment=PYTHONUNBUFFERED=1
Environment=PGPASSFILE=/home/dev-admin/.pgpass
ExecStartPre=+/usr/bin/chvt 2
ExecStart=/home/dev-admin/game/venv/bin/python -m ops.monitor
Restart=always
RestartSec=2
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=no
TTYVTDisallocate=no
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target